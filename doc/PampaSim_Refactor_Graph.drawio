        <mxCell id="L1sYtbS1Cf7boD85PsUE-30" value="&lt;i&gt;ProcessDispatch&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=#9673a6;fillColor=#e1d5e7;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
