<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<TabPane xmlns="http://javafx.com/javafx/22.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.pampasim.resources.view.PCBView">
   <tabs>
      <Tab text="PCB">
         <content>
            <VBox>
                <TitledPane text="Gerência de Processos">
                    <VBox spacing="10">
                        <GridPane hgap="10" vgap="10">
                            <Label text="PID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <Label fx:id="pidLabel" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                            <Label text="Cor:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <Label fx:id="colorLabel" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                            <Label text="Estado:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                            <Label fx:id="stateLabel" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                            <Label text="Tempo de Chegada:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                            <Label fx:id="arrivalTickLabel" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                            <Label text="Prioridade:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                            <Label fx:id="priorityLabel" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                            <Label text="Tempo Decorrente de Execução:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                            <Label fx:id="currExecTimeLabel" GridPane.columnIndex="1" GridPane.rowIndex="6" />

                            <Label text="Tempo Total de Execução: " GridPane.columnIndex="0" GridPane.rowIndex="5" />
                            <Label fx:id="burstLabel" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                          <columnConstraints>
                             <ColumnConstraints />
                             <ColumnConstraints />
                          </columnConstraints>
                          <rowConstraints>
                             <RowConstraints />
                           <RowConstraints />
                             <RowConstraints />
                             <RowConstraints />
                             <RowConstraints />
                             <RowConstraints />
                             <RowConstraints />
                          </rowConstraints>
                          <VBox.margin>
                             <Insets />
                          </VBox.margin>
                        </GridPane>
                    </VBox>
                </TitledPane>
                <TitledPane fx:id="processMemoryInfoTitledPane" text="Gerência de Memória">
                    <content>
                        <VBox spacing="10">
                            <GridPane hgap="10" vgap="10">
                                <Label text="Tamanho (em páginas):" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <Label fx:id="memorySizeLabel" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <Label text="Máximo de páginas na RAM:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <Label fx:id="maxPagesRamLabel" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label text="Page Hits:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                <Label fx:id="pageHitsLabel" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                <Label text="Page Faults:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                <Label fx:id="pageFaultsLabel" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                <Label text="Taxa de Page Faults:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                <Label fx:id="pageFaultRateLabel" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                                <Label text="Tamanho da Janela do Working Set:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                                <Label fx:id="workingSetWindowLabel" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                                <columnConstraints>
                                    <ColumnConstraints />
                                    <ColumnConstraints />
                                </columnConstraints>
                                <rowConstraints>
                                    <RowConstraints />
                                    <RowConstraints />
                                    <RowConstraints />
                                    <RowConstraints />
                                    <RowConstraints />
                                    <RowConstraints />
                                </rowConstraints>
                                <VBox.margin>
                                    <Insets bottom="10.0" />
                                </VBox.margin>
                            </GridPane>

                            <VBox spacing="5">
                                <Label text="Working Set:" />
                                <Label fx:id="workingSetListLabel" wrapText="true" />

                                <Label text="Lista de Acessos:" />
                                <Label fx:id="accessListLabel" wrapText="true" />
                            </VBox>
                        </VBox>
                    </content>
                </TitledPane>
            </VBox>
         </content>
      </Tab>
   </tabs>
</TabPane>
