<?xml version="1.0" encoding="UTF-8"?>

<xs:schema
        xmlns:xs="http://www.w3.org/2001/XMLSchema"
        elementFormDefault="qualified" >
<xs:complexType name="event">
    <xs:sequence>
        <!-- allow arbitrary payloads -->
        <!-- FIXME: figure out a way to give each event kind a schema -->
        <xs:any minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="timing" type="xs:string" default="instant"/>
    <!-- FIXME: timing characteristic complex type -->
</xs:complexType>
</xs:schema>