events {
  transmitting org.pampasim.core.resources.Process {
    Arrival;
    Allocate;
    Ready;
    Schedule;
    Dispatch;
    Run;
    RunAck;
    RunContinue;
    IoOperation;
    Preemption;
    RunPaused;
    End;
    Kill;
  }
}

ProcessManager {
  on Arrival do "create process" chains Allocate;
  on Ready do "schedule for execution" chains Schedule;
  on RunPaused do "schedule for execution or end process" chains Schedule; // + End;
}

Scheduler {
  on Schedule do "ask memory to load process" chains Dispatch;
  // may chain Preemption;
}

Processor {
  on Preemption do "suspend and evict current process" chains RunPaused;
  on RunContinue do "drive process execution" chains RunContinue;
  on Run do "start process execution" chains RunContinue;
}

Memory {
  on Allocate do "allocate memory" chains Ready;
  on End do "free memory" chains Kill;
  on Dispatch do "run process" chains Run;
  on IoOperation do "perform expensive IO operations" chains Schedule;
}
