events {
  transmitting org.pampasim.core.resources.Process {
    Arrival;
    Allocate;
    Ready;
    Schedule;
    Dispatch;
    Run;
    RunAck;
    RunContinue;
    IoOperation;
    Preemption;
    RunPaused;
    End;
    Kill;
  }
}

ProcessManager {
  on Arrival { IDLE -> NEW; }
  on Ready { IDLE -> READY; }
  on RunPaused { IDLE -> ENDED; }
}

Scheduler {
  on Schedule{ IDLE -> ENQUEUE; }
  on RunAck { IDLE -> EXEC_ACK; }
}

Processor {
  on Preemption { EXEC -> CTX_SWITCH; }
  on RunContinue { EXEC -> EXEC; }
  on Run { IDLE -> EXEC; }
}

Memory {
  on Allocate { IDLE -> ALLOC; }
  on End { IDLE -> FREE; }
  on Dispatch { IDLE -> LOAD_PROC; }
  on IoOperation { IDLE -> IO; }
}
