events {
  Process transmitting org.pampasim.core.resources.Process {
    Arrival;
    Allocate;
    Ready;
    Schedule;
    Dispatch;
    Run;
    Load;
    IoOperation;
    Preemption;
    RunPaused;
    End;
    Kill;
  }
}

ProcessManager {
  on Process.Arrival do "create process" chains Process.Allocate;
  on Process.Ready do "schedule for execution" chains Process.Schedule;
  on Process.RunPaused do "schedule for execution or end process" chains Process.Schedule; // + End;
}

Scheduler {
  on Process.Schedule do "ask memory to load process" chains Process.Dispatch;
  // may chain Process.Preemption;
}

Processor {
  on Process.Preemption do "suspend and evict current process" chains Process.RunPaused;
  on Process.Dispatch do "request for memory to load the pages for the current execution tick" chains Process.Run;
  on Process.Run do "run process for 1 tick" chains Process.Load;
}

Memory {
  on Process.Allocate do "allocate memory" chains Process.Ready;
  on Process.End do "free memory" chains Process.Kill;
  on Process.Load do "Load requested pages into main memory" chains Process.Run; // Could also result in the process being suspended, and eventually a Process.Schedule event
  on Process.IoOperation do "perform expensive IO operations" chains Process.Schedule;
}
