<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonType?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<DialogPane minHeight="540" minWidth="780" prefHeight="540" prefWidth="780" style="-fx-font-size: 17px;" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.pampasim.view.AddSpecOrModulesDialogView">
  <content>
    <VBox alignment="CENTER" spacing="10">
         <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@../../../imgs/pampasimlogo.png" />
            </image>
            <VBox.margin>
               <Insets bottom="35.0" />
            </VBox.margin>
         </ImageView>

      <Label text="Módulos Ativos:" />
      <VBox alignment="CENTER" spacing="10">
          <CheckBox fx:id="processorCheckBox" disable="true" prefHeight="24.0" selected="true" text="Processador" />
          <CheckBox fx:id="memoryCheckBox" text="Memória" />
      </VBox>
      <Region prefHeight="5" />
      <Label fx:id="specFeedback" text="${viewModel.specFeedback}" />
          <Button fx:id="loadSpecBtn" alignment="CENTER" contentDisplay="TOP" graphicTextGap="5.0" minWidth="-Infinity" mnemonicParsing="false" onAction="#loadSpec" text="Carregar Cenário" textFill="#1976d2">
            <tooltip>
              <Tooltip text="Carrega arquivo de descrição de cenário" />
            </tooltip>
              <graphic>
                <FontIcon iconColor="#1976d2" iconLiteral="bi-upload" iconSize="22" selectionFill="BLACK">
                      <font>
                        <Font size="27.0" />
                      </font>
                </FontIcon>
                  </graphic>
                     <font>
                        <Font size="12.0" />
                     </font>
        </Button>
    </VBox>
  </content>
  <buttonTypes>
    <!-- <ButtonType fx:id="cancelButton" buttonData="CANCEL_CLOSE" text="Cancel" /> !-->
    <ButtonType fx:id="okButton" buttonData="APPLY" text="OK" />
  </buttonTypes>
</DialogPane>
