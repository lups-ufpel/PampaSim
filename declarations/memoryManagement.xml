<?xml version="1.0" encoding="UTF-8"?>

<simulationDescription
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <events>
        <import>declarations/processManagement.xml</import>
        <eventGroup name="Memory">
            <payloads>
                <class>
                    <fullyQualifiedClassName>org.pampasim.resources.Process</fullyQualifiedClassName>
                </class>
            </payloads>
            <event>Allocate</event>
            <event>AllocateFinished</event>
            <event>DeletePageTableEntry</event>
            <event>DeleteTlbEntry</event>
            <event>FreeProcessMemory</event>
            <event>FreeProcessMemoryFinished</event>
            <event>IoOperation</event>
            <event>PageFault</event>
            <event>PageHit</event>
            <event>ProcessReady</event>
            <event>DiskOperation</event>
            <event>DiskOperationFinished</event>
            <event>TlbNoTranslation</event>
            <event>TranslateVirtualAddress</event>
        </eventGroup>
    </events>

    <entity name="PageTable">
        <handler>
            <event>
                <name>DeletePageTableEntry</name>
                <group>Memory</group>
            </event>
            <do>delete page table entry</do>
            <chains>
                <event>
                    <name>FreeProcessMemory</name>
                    <group>Memory</group>
                </event>
            </chains>
        </handler>
        <handler>
            <event>
                <name>Allocate</name>
                <group>Memory</group>
            </event>
            <do>allocate memory</do>
            <chains>
                <event>
                    <name>AllocateFinished</name>
                    <group>Memory</group>
                </event>
            </chains>
        </handler>
        <handler>
            <event>
                <name>TlbNoTranslation</name>
                <group>Memory</group>
            </event>
            <do>check page table</do>
            <chains>
                <or>
                    <alt>
                        <event>
                            <name>PageHit</name>
                            <group>Memory</group>
                        </event>
                    </alt>
                    <alt>
                        <event>
                            <name>PageFault</name>
                            <group>Memory</group>
                        </event>
                    </alt>
                </or>
            </chains>
        </handler>
    </entity>
    <entity name="PhysicalMemory">
        <handler>
            <event>
                <name>FreeProcessMemory</name>
                <group>Memory</group>
            </event>
            <do>free process memory</do>
        </handler>
        <handler>
            <event>
                <name>PageHit</name>
                <group>Memory</group>
            </event>
            <do>page hit</do>
            <chains>
                <event>
                    <name>ProcessReady</name>
                    <group>Memory</group>
                </event>
            </chains>
        </handler>
        <handler>
            <event>
                <name>PageFault</name>
                <group>Memory</group>
            </event>
            <do>page fault</do>
            <chains>
                <event>
                    <name>DiskOperation</name>
                    <group>Memory</group>
                </event>
            </chains>
        </handler>
        <handler>
            <event>
                <name>DiskOperation</name>
                <group>Memory</group>
            </event>
            <do>time advance</do>
            <chains>
                <or>
                    <alt>
                        <event>
                            <name>DiskOperation</name>
                            <group>Memory</group>
                        </event>
                    </alt>
                    <alt>
                        <event>
                            <name>DiskOperationFinished</name>
                            <group>Memory</group>
                        </event>
                    </alt>
                </or>
            </chains>
        </handler>
        <handler>
            <event>
                <name>IoOperation</name>
                <group>Memory</group>
            </event>
            <do>start disk operation</do>
            <chains>
                <event>
                    <name>DiskOperation</name>
                    <group>Memory</group>
                </event>
            </chains>
        </handler>
    </entity>
    <entity name="TLB">
        <handler>
            <event>
                <name>TranslateVirtualAddress</name>
                <group>Memory</group>
            </event>
            <do>translate virtual address</do>
            <chains>
                <or>
                    <alt>
                        <event>
                            <name>PageHit</name>
                            <group>Memory</group>
                        </event>
                    </alt>
                    <alt>
                        <event>
                            <name>PageFault</name>
                            <group>Memory</group>
                        </event>
                    </alt>
                    <alt>
                        <event>
                            <name>TlbNoTranslation</name>
                            <group>Memory</group>
                        </event>
                    </alt>
                </or>
            </chains>
        </handler>
    </entity>
    <entity name="VirtualMemory">
        <handler>
            <event>
                <name>Allocate</name>
                <group>Process</group>
            </event>
            <do>allocate process</do>
            <chains>
                <event>
                    <name>Allocate</name>
                    <group>Memory</group>
                </event>
            </chains>
        </handler>
        <handler>
            <event>
                <name>End</name>
                <group>Process</group>
            </event>
            <do>end process</do>
            <chains>
                <event>
                    <name>DeletePageTableEntry</name>
                    <group>Memory</group>
                </event>
            </chains>
        </handler>
        <handler>
            <event>
                <name>Load</name>
                <group>Process</group>
            </event>
            <do>load requested pages into memory</do>
            <chains>
                <event>
                    <name>TranslateVirtualAddress</name>
                    <group>Memory</group>
                </event>
            </chains>
        </handler>
        <handler>
            <event>
                <name>IoOperation</name>
                <group>Process</group>
            </event>
            <do>perform expensive IO operations</do>
            <chains>
                <event>
                    <name>DiskOperation</name>
                    <group>Memory</group>
                </event>
            </chains>
        </handler>
        <handler>
            <event>
                <name>AllocateFinished</name>
                <group>Memory</group>
            </event>
            <do/>
            <chains>
                <event>
                    <name>Ready</name>
                    <group>Process</group>
                </event>
            </chains>
        </handler>
        <handler>
            <event>
                <name>FreeProcessMemoryFinished</name>
                <group>Memory</group>
            </event>
            <do>
            </do>
            <chains>
                <event>
                    <name>Kill</name>
                    <group>Process</group>
                </event>
            </chains>
        </handler>
        <handler>
            <event>
                <name>DiskOperationFinished</name>
                <group>Memory</group>
            </event>
            <do/>
            <chains>
                <event>
                    <name>Schedule</name>
                    <group>Process</group>
                </event>
            </chains>
        </handler>
        <handler>
            <event>
                <name>Ready</name>
                <group>Process</group>
            </event>
            <do/>
            <chains>
                <event>
                    <name>Run</name>
                    <group>Process</group>
                </event>
            </chains>
        </handler>
    </entity>
</simulationDescription>
